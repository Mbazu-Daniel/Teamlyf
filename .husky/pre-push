#!/usr/bin/env sh

# ── Branch name validation ──────────────────────────────────────────
MAX_FILES=50
BRANCH="$(git rev-parse --abbrev-ref HEAD)"
BRANCH_PATTERN='^(feat|fix|refactor|chore|docs|test|ci|build|perf|style|hotfix)/[a-z0-9][a-z0-9/-]*$'

case "$BRANCH" in
  main|master|dev|HEAD) ;;
  *)
    if ! printf '%s\n' "$BRANCH" | grep -Eq "$BRANCH_PATTERN"; then
      echo "BLOCKED: invalid branch name: $BRANCH"
      echo ""
      echo "Expected: type/short-slug"
      echo "Examples: feat/better-auth-mount  fix/health-check  chore/husky-hooks"
      exit 1
    fi
    ;;
esac

# ── Fallow audit (runs on EVERY branch) ─────────────────────────────
BASE=""
if git show-ref --verify --quiet refs/heads/main; then
  BASE="main"
elif git show-ref --verify --quiet refs/remotes/origin/main; then
  BASE="origin/main"
elif git show-ref --verify --quiet refs/heads/master; then
  BASE="master"
elif git show-ref --verify --quiet refs/remotes/origin/master; then
  BASE="origin/master"
fi

if [ -n "$BASE" ]; then
  echo "Running fallow audit against $BASE …"
  FALLOW_JSON="$(npx fallow audit --base "$BASE" --format json 2>/dev/null)"
  FALLOW_EXIT=$?

  # Parse verdict from JSON — CLI exits 0 for warn, so we check explicitly
  VERDICT="$(echo "$FALLOW_JSON" | node -e "let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{try{console.log(JSON.parse(d).verdict||'pass')}catch{console.log('pass')}})" 2>/dev/null)"

  if [ "$FALLOW_EXIT" -ne 0 ] || [ "$VERDICT" = "fail" ] || [ "$VERDICT" = "warn" ]; then
    echo "$FALLOW_JSON" | node -e "
      let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{
        const r=JSON.parse(d);
        const s=r.summary||{};
        const findings=[];
        if(s.dead_code_issues) findings.push('  dead code: '+s.dead_code_issues+' issues');
        if(s.complexity_findings) findings.push('  complexity: '+s.complexity_findings+' findings');
        if(s.duplication_clone_groups) findings.push('  duplication: '+s.duplication_clone_groups+' clone groups');
        console.log('Fallow verdict: '+r.verdict);
        if(findings.length) console.log(findings.join('\n'));
        console.log('');
      });
    " 2>/dev/null
    echo "BLOCKED: fallow audit found issues (verdict: $VERDICT)."
    echo "Fix findings or add a suppression comment (// fallow-ignore-next-line)."
    echo "Docs: https://fallow.mintlify.app/"
    exit 1
  fi

  echo "Fallow audit passed ✓"
else
  echo "WARNING: no main/master base found; skipping fallow audit"
fi

# ── File-count gate (skip on protected branches) ────────────────────
case "$BRANCH" in
  main|master|dev)
    exit 0
    ;;
esac

if [ -z "$BASE" ]; then
  exit 0
fi

CHANGED_FILES="$(git diff --name-only "$BASE"...HEAD | wc -l | tr -d ' ')"

if [ "$CHANGED_FILES" -gt "$MAX_FILES" ]; then
  echo "BLOCKED: branch '$BRANCH' changes $CHANGED_FILES files (max: $MAX_FILES)"
  echo ""
  echo "Keep branches small. Split the work into multiple PRs/branches."
  echo "Base compared: $BASE"
  exit 1
fi
