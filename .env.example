DATABASE_URL=postgresql://postgres:postgres@localhost:5432/teamlyf-hack
# Required — Socket.IO's cross-instance adapter, chat presence and typing state.
# Without it the API refuses to start (a process-local fallback would silently
# drop messages between replicas).
REDIS_URL=redis://localhost:6379
API_PORT=3101
WEB_ORIGIN=http://localhost:3100
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3101
# Dev: apps/web Vite dev proxy sends /api to http://localhost:${API_PORT}.
# The browser client defaults to same-origin /api/v1. Uncomment to proxy elsewhere.
# VITE_API_PROXY_TARGET=http://localhost:3101
# The client also accepts an API origin or a base ending in /api/v1.
# VITE_API_URL=/api/v1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Web: browser-facing LiveKit URL (VITE_ vars are exposed to the client).
# VITE_LIVEKIT_URL=
# Web: chat socket origin; unset means same-origin /socket.io (proxied by Vite).
# VITE_WS_URL=

BACHS_API_URL=
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=

AGENT_ENCRYPTION_SECRET=
AGENT_MANAGED_API_KEY=
AGENT_OPENAI_BASE_URL=https://api.openai.com/v1

# Object storage (R2). R2_ACCOUNT_ID, R2_BUCKET_NAME, R2_ACCESS_KEY_ID and
# R2_SECRET_ACCESS_KEY are required. Optional: R2_ENDPOINT, R2_PUBLIC_ID or
# R2_CUSTOM_DOMAIN to expose public read URLs, else reads use presigned GETs.
# R2_ENDPOINT=
# R2_PUBLIC_ID=
# R2_CUSTOM_DOMAIN=
# STORAGE_URL_TTL_SECONDS=3600
# STORAGE_MAX_UPLOAD_BYTES=26214400
